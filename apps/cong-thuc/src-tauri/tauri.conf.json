{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "msi"
    ]
  },
  "productName": "cong-thuc",
  "mainBinaryName": "cong-thuc",
  "version": "0.1.0",
  "identifier": "com.linhhuong.cong-thuc",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Linh Hương cong-thuc",
        "width": 1200,
        "height": 800,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}